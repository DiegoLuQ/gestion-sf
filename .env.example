# Copia este archivo como .env y completa los valores.
# En Hostinger puedes cargar estas variables en el panel de la app Node.js.
DATABASE_URL=mysql://USUARIO:CLAVE@localhost:3306/NOMBRE_BASE
# O bien, por separado:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
PORT=3000
# Migraciones al iniciar el servidor (true por defecto). Con false se aplican solo con npm run migrar.
AUTO_MIGRAR=true
# Contraseña del usuario admin si la migración crea la base desde cero (si falta, se genera una y se muestra en el log).
# ADMIN_PASSWORD=
# Página web pública
# SITE_URL=https://santiagofiltros.cl
# BLOQUEO_BOTS=true
# LIMITE_SOLICITUDES_MINUTO=120
