{
  "name": "santiago-filtros-gestion",
  "version": "2.0.0",
  "description": "Sistema de gestión de Santiago Filtros: inventario, pedidos y ventas",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrar": "node database/migrar.js",
    "migrar:estado": "node database/migrar.js --estado",
    "exportar": "node database/exportar.js",
    "vistas": "node database/vistas.js",
    "imagenes:optimizar": "node database/optimizar-imagenes.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.4"
  }
}
